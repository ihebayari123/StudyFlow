{% extends 'base.html.twig' %}
{% block title %}Chatbot Anti-Stress{% endblock %}
{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        *{margin:0;padding:0;box-sizing:border-box}
        body{font-family:'Segoe UI',Tahoma,Geneva,Verdana,sans-serif;background:linear-gradient(135deg,#667eea 0%,#764ba2 100%);min-height:100vh}
        .header-area{background:rgba(0,0,0,.25)!important;backdrop-filter:blur(10px)}
        .header-area .logo h1,.header-area .nav a,nav,.navbar,nav *,.navbar *,.nav-link{color:white!important}
        .page-wrap{padding:110px 20px 60px;max-width:1200px;margin:0 auto}
        .page-title{text-align:center;color:white;font-size:2.5rem;font-weight:800;margin-bottom:8px;text-shadow:2px 2px 8px rgba(0,0,0,.2)}
        .page-sub{text-align:center;color:rgba(255,255,255,.8);font-size:1.05rem;margin-bottom:40px}
        .main-grid{display:grid;grid-template-columns:1fr 420px;gap:25px;align-items:start}
        @media(max-width:900px){.main-grid{grid-template-columns:1fr}}
        /* Chat panel */
        .chat-panel{background:white;border-radius:24px;overflow:hidden;box-shadow:0 20px 60px rgba(0,0,0,.25);display:flex;flex-direction:column;height:620px}
        .chat-header{background:linear-gradient(135deg,#667eea,#764ba2);padding:20px 25px;display:flex;align-items:center;gap:15px}
        .bot-avatar{width:50px;height:50px;background:rgba(255,255,255,.2);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:1.5rem;color:white}
        .bot-info h3{color:white;font-size:1.1rem;font-weight:700;margin-bottom:2px}
        .bot-info p{color:rgba(255,255,255,.75);font-size:.8rem}
        .bot-status{width:10px;height:10px;background:#4ade80;border-radius:50%;margin-left:auto;box-shadow:0 0 8px #4ade80;animation:pulse 2s infinite}
        @keyframes pulse{0%,100%{opacity:1}50%{opacity:.5}}
        .chat-messages{flex:1;overflow-y:auto;padding:20px;background:#f8fafc;display:flex;flex-direction:column;gap:15px}
        .msg{display:flex;gap:10px;align-items:flex-end}
        .msg.user{flex-direction:row-reverse}
        .msg-avatar{width:36px;height:36px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:.9rem;flex-shrink:0}
        .msg.bot .msg-avatar{background:linear-gradient(135deg,#667eea,#764ba2);color:white}
        .msg.user .msg-avatar{background:linear-gradient(135deg,#4ade80,#22c55e);color:white}
        .msg-bubble{max-width:75%;padding:12px 16px;border-radius:18px;font-size:.9rem;line-height:1.5}
        .msg.bot .msg-bubble{background:white;color:#1f2937;border-bottom-left-radius:4px;box-shadow:0 2px 8px rgba(0,0,0,.08)}
        .msg.user .msg-bubble{background:linear-gradient(135deg,#667eea,#764ba2);color:white;border-bottom-right-radius:4px}
        .msg-time{font-size:.7rem;color:#9ca3af;margin-top:4px;text-align:right}
        .typing-indicator{display:flex;gap:5px;padding:12px 16px;background:white;border-radius:18px;border-bottom-left-radius:4px;box-shadow:0 2px 8px rgba(0,0,0,.08);width:fit-content}
        .typing-dot{width:8px;height:8px;background:#667eea;border-radius:50%;animation:typing .8s infinite}
        .typing-dot:nth-child(2){animation-delay:.2s}
        .typing-dot:nth-child(3){animation-delay:.4s}
        @keyframes typing{0%,100%{transform:translateY(0)}50%{transform:translateY(-6px)}}
        .chat-input-area{padding:15px 20px;background:white;border-top:1px solid #f3f4f6;display:flex;gap:10px}
        .chat-input{flex:1;padding:12px 16px;border:2px solid #e5e7eb;border-radius:12px;font-size:.95rem;outline:none;transition:border-color .3s}
        .chat-input:focus{border-color:#667eea}
        .send-btn{width:44px;height:44px;background:linear-gradient(135deg,#667eea,#764ba2);color:white;border:none;border-radius:12px;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all .3s}
        .send-btn:hover{transform:scale(1.05)}
        /* Right panel */
        .right-panel{display:flex;flex-direction:column;gap:20px}
        .panel-card{background:white;border-radius:20px;overflow:hidden;box-shadow:0 10px 30px rgba(0,0,0,.15)}
        .panel-card-header{padding:18px 22px;display:flex;align-items:center;gap:12px;font-weight:700;font-size:1rem;color:white}
        .panel-card-header.purple{background:linear-gradient(135deg,#667eea,#764ba2)}
        .panel-card-header.green{background:linear-gradient(135deg,#4ade80,#22c55e)}
        .panel-card-header.orange{background:linear-gradient(135deg,#fb923c,#ea580c)}
        .panel-card-body{padding:20px}
        /* Score input */
        .score-input-wrap{display:flex;flex-direction:column;gap:12px}
        .score-input-wrap input,.score-input-wrap input[type=text]{width:100%;padding:12px 16px;border:2px solid #e5e7eb;border-radius:10px;font-size:1rem;outline:none;transition:border-color .3s}
        .score-input-wrap input:focus{border-color:#667eea}
        .score-display{text-align:center;padding:15px;background:linear-gradient(135deg,#f0f4ff,#e8ecff);border-radius:12px}
        .score-number{font-size:3rem;font-weight:800;color:#667eea;line-height:1}
        .score-label{font-size:.85rem;color:#6b7280;margin-top:5px}
        .score-bar-wrap{height:10px;background:#e5e7eb;border-radius:5px;overflow:hidden;margin-top:10px}
        .score-bar-fill{height:100%;border-radius:5px;background:linear-gradient(90deg,#667eea,#764ba2);transition:width .5s}
        .btn-analyze{width:100%;padding:14px;background:linear-gradient(135deg,#667eea,#764ba2);color:white;border:none;border-radius:12px;font-size:1rem;font-weight:700;cursor:pointer;transition:all .3s;margin-top:10px;display:flex;align-items:center;justify-content:center;gap:8px}
        .btn-analyze:hover{transform:translateY(-2px);box-shadow:0 8px 20px rgba(102,126,234,.4)}
        /* Camera */
        .camera-wrap{display:flex;flex-direction:column;gap:12px}
        #videoEl{width:100%;border-radius:12px;background:#000;display:none}
        #canvasEl{display:none}
        #photoPreview{width:100%;border-radius:12px;display:none;border:3px solid #4ade80}
        .camera-btns{display:flex;gap:8px}
        .btn-cam{flex:1;padding:10px;border:none;border-radius:10px;font-size:.85rem;font-weight:600;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:6px;transition:all .3s}
        .btn-cam.start{background:linear-gradient(135deg,#4ade80,#22c55e);color:white}
        .btn-cam.snap{background:linear-gradient(135deg,#667eea,#764ba2);color:white}
        .btn-cam.retake{background:linear-gradient(135deg,#fb923c,#ea580c);color:white}
        .btn-cam:hover{transform:translateY(-1px)}
        /* PDF */
        .btn-pdf{width:100%;padding:14px;background:linear-gradient(135deg,#fb923c,#ea580c);color:white;border:none;border-radius:12px;font-size:1rem;font-weight:700;cursor:pointer;transition:all .3s;display:flex;align-items:center;justify-content:center;gap:8px}
        .btn-pdf:hover{transform:translateY(-2px);box-shadow:0 8px 20px rgba(251,146,60,.4)}
        .btn-pdf:disabled{opacity:.5;cursor:not-allowed;transform:none}
        /* Results */
        #resultsSection{display:none}
        .result-card{background:white;border-radius:20px;padding:25px;box-shadow:0 10px 30px rgba(0,0,0,.15);margin-top:20px}
        .result-title{font-size:1.2rem;font-weight:700;color:#1f2937;margin-bottom:15px;display:flex;align-items:center;gap:8px}
        .rec-item{display:flex;align-items:flex-start;gap:10px;padding:10px 0;border-bottom:1px solid #f3f4f6;font-size:.9rem;color:#374151;line-height:1.5}
        .rec-item:last-child{border-bottom:none}
        .schedule-table{width:100%;border-collapse:collapse;font-size:.85rem}
        .schedule-table th{background:linear-gradient(135deg,#667eea,#764ba2);color:white;padding:10px 12px;text-align:left}
        .schedule-table td{padding:9px 12px;border-bottom:1px solid #f3f4f6;color:#374151}
        .schedule-table tr:hover td{background:#f8fafc}
        /* Hidden PDF template */
        #pdfTemplate{display:none}
    </style>
{% endblock %}
{% block body %}
{% block header %}{% include 'home/navbar.html.twig' %}{% endblock %}
<div class="page-wrap">
    <h1 class="page-title"><i class="fas fa-robot"></i> Chatbot Anti-Stress</h1>
    <p class="page-sub">Analyse IA personnalisée · Caméra · Rapport PDF téléchargeable</p>
    <div class="main-grid">
        <!-- LEFT: Chat -->
        <div class="chat-panel">
            <div class="chat-header">
                <div class="bot-avatar"><i class="fas fa-robot"></i></div>
                <div class="bot-info">
                    <h3>StudyBot Anti-Stress</h3>
                    <p>Propulsé par Machine Learning</p>
                </div>
                <div class="bot-status"></div>
            </div>
            <div class="chat-messages" id="chatMessages">
                <div class="msg bot">
                    <div class="msg-avatar"><i class="fas fa-robot"></i></div>
                    <div>
                        <div class="msg-bubble">
                            👋 Bonjour ! Je suis votre assistant anti-stress.<br><br>
                            Vos données du sondage ont été enregistrées :<br>
                            🌙 Sommeil : <strong>{{ survey.sleepHours }}h</strong><br>
                            📚 Étude : <strong>{{ survey.studyHours }}h</strong><br>
                            📅 Date : <strong>{{ survey.date ? survey.date|date('d/m/Y') : 'N/A' }}</strong><br><br>
                            Pour commencer l'analyse, <strong>entrez votre prénom et votre score</strong> dans le panneau de droite, puis cliquez sur <em>"Analyser"</em>.
                        </div>
                        <div class="msg-time">Maintenant</div>
                    </div>
                </div>
            </div>
            <div class="chat-input-area">
                <input type="text" class="chat-input" id="chatInput" placeholder="Posez une question..." onkeypress="if(event.key==='Enter')sendChat()">
                <button class="send-btn" onclick="sendChat()"><i class="fas fa-paper-plane"></i></button>
            </div>
        </div>
        <!-- RIGHT: Controls -->
        <div class="right-panel">
            <!-- Score & Nom -->
            <div class="panel-card">
                <div class="panel-card-header purple">
                    <i class="fas fa-chart-line"></i> Votre Profil
                </div>
                <div class="panel-card-body">
                    <div class="score-input-wrap">
                        <input type="text" id="nomInput" placeholder="Votre prénom (ex: Ahmed)">
                        <input type="number" id="scoreInput" placeholder="Votre score (0-100)" min="0" max="100" oninput="updateScoreDisplay()">
                        <div class="score-display">
                            <div class="score-number" id="scoreDisplay">--</div>
                            <div class="score-label">Score de bien-être</div>
                            <div class="score-bar-wrap">
                                <div class="score-bar-fill" id="scoreBarFill" style="width:0%"></div>
                            </div>
                        </div>
                        <button class="btn-analyze" onclick="runAnalysis()">
                            <i class="fas fa-brain"></i> Analyser avec l'IA
                        </button>
                    </div>
                </div>
            </div>
            <!-- Camera -->
            <div class="panel-card">
                <div class="panel-card-header green">
                    <i class="fas fa-camera"></i> Photo pour le rapport
                </div>
                <div class="panel-card-body">
                    <div class="camera-wrap">
                        <video id="videoEl" autoplay playsinline></video>
                        <canvas id="canvasEl" width="400" height="300"></canvas>
                        <img id="photoPreview" alt="Votre photo">
                        <div class="camera-btns">
                            <button class="btn-cam start" id="btnStart" onclick="startCamera()">
                                <i class="fas fa-video"></i> Activer
                            </button>
                            <button class="btn-cam snap" id="btnSnap" onclick="takePhoto()" style="display:none">
                                <i class="fas fa-camera"></i> Prendre
                            </button>
                            <button class="btn-cam retake" id="btnRetake" onclick="retakePhoto()" style="display:none">
                                <i class="fas fa-redo"></i> Reprendre
                            </button>
                        </div>
                        <p style="font-size:.8rem;color:#9ca3af;text-align:center">
                            <i class="fas fa-info-circle"></i> La photo sera incluse dans votre rapport PDF
                        </p>
                    </div>
                </div>
            </div>
            <!-- PDF Download -->
            <div class="panel-card">
                <div class="panel-card-header orange">
                    <i class="fas fa-file-pdf"></i> Rapport PDF
                </div>
                <div class="panel-card-body">
                    <p style="font-size:.85rem;color:#6b7280;margin-bottom:12px">
                        Le rapport contient : votre photo, les recommandations personnalisées et votre emploi du temps.
                    </p>
                    <button class="btn-pdf" id="btnPdf" onclick="downloadPDF()" disabled>
                        <i class="fas fa-download"></i> Télécharger le PDF
                    </button>
                </div>
            </div>
        </div>
    </div>
    <!-- Results section -->
    <div id="resultsSection">
        <div class="result-card">
            <div class="result-title"><i class="fas fa-lightbulb" style="color:#f59e0b"></i> Recommandations personnalisées</div>
            <div id="recsList"></div>
        </div>
        <div class="result-card">
            <div class="result-title"><i class="fas fa-calendar-alt" style="color:#667eea"></i> Emploi du temps personnalisé</div>
            <table class="schedule-table">
                <thead><tr><th>Heure</th><th>Activité</th></tr></thead>
                <tbody id="scheduleBody"></tbody>
            </table>
        </div>
    </div>
</div>
<!-- Hidden PDF template -->
<div id="pdfTemplate"></div>
{% endblock %}
{% block body_scripts %}
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script>
const SURVEY_DATA = {
    sleepHours: {{ survey.sleepHours }},
    studyHours: {{ survey.studyHours }},
    date: "{{ survey.date ? survey.date|date('d/m/Y') : 'N/A' }}"
};
const PREDICT_URL = "{{ path('app_stresse_api_predict') }}";

let analysisResult = null;
let photoDataUrl = null;
let cameraStream = null;

// ── Score display ──
function updateScoreDisplay() {
    const v = parseInt(document.getElementById('scoreInput').value) || 0;
    const clamped = Math.min(100, Math.max(0, v));
    document.getElementById('scoreDisplay').textContent = clamped;
    document.getElementById('scoreBarFill').style.width = clamped + '%';
    const colors = clamped >= 70 ? 'linear-gradient(90deg,#4ade80,#22c55e)'
                 : clamped >= 40 ? 'linear-gradient(90deg,#fb923c,#f59e0b)'
                 : 'linear-gradient(90deg,#f87171,#ef4444)';
    document.getElementById('scoreBarFill').style.background = colors;
}

// ── Chat helpers ──
function addMsg(text, role) {
    const wrap = document.getElementById('chatMessages');
    const div = document.createElement('div');
    div.className = 'msg ' + role;
    const icon = role === 'bot' ? 'fa-robot' : 'fa-user';
    const now = new Date().toLocaleTimeString('fr-FR', {hour:'2-digit',minute:'2-digit'});
    div.innerHTML = `
        <div class="msg-avatar"><i class="fas ${icon}"></i></div>
        <div>
            <div class="msg-bubble">${text}</div>
            <div class="msg-time">${now}</div>
        </div>`;
    wrap.appendChild(div);
    wrap.scrollTop = wrap.scrollHeight;
}

function showTyping() {
    const wrap = document.getElementById('chatMessages');
    const div = document.createElement('div');
    div.className = 'msg bot'; div.id = 'typingMsg';
    div.innerHTML = `<div class="msg-avatar"><i class="fas fa-robot"></i></div>
        <div class="typing-indicator">
            <div class="typing-dot"></div><div class="typing-dot"></div><div class="typing-dot"></div>
        </div>`;
    wrap.appendChild(div);
    wrap.scrollTop = wrap.scrollHeight;
}
function hideTyping() {
    const t = document.getElementById('typingMsg');
    if (t) t.remove();
}

// ── Chat send ──
function sendChat() {
    const input = document.getElementById('chatInput');
    const text = input.value.trim();
    if (!text) return;
    addMsg(text, 'user');
    input.value = '';
    showTyping();
    setTimeout(() => {
        hideTyping();
        const lower = text.toLowerCase();
        let reply = '';
        if (lower.includes('stress')) {
            reply = analysisResult
                ? `📊 Votre niveau de stress estimé est <strong>${analysisResult.stress_pct}%</strong> (${analysisResult.stress_level}). ${analysisResult.stress_pct > 70 ? '⚠️ Niveau élevé — consultez un professionnel.' : '✅ Niveau acceptable.'}`
                : "Lancez d'abord l'analyse en entrant votre prénom et score, puis cliquez sur <em>Analyser</em>.";
        } else if (lower.includes('sommeil') || lower.includes('sleep')) {
            reply = `🌙 Vous avez dormi <strong>${SURVEY_DATA.sleepHours}h</strong>. ${SURVEY_DATA.sleepHours < 7 ? '⚠️ C\'est insuffisant. Visez 7-9h.' : '✅ Bon niveau de sommeil !'}`;
        } else if (lower.includes('étude') || lower.includes('etude') || lower.includes('study')) {
            reply = `📚 Vous avez étudié <strong>${SURVEY_DATA.studyHours}h</strong>. ${SURVEY_DATA.studyHours > 10 ? '⚠️ Trop d\'heures ! Utilisez la technique Pomodoro.' : '✅ Charge raisonnable.'}`;
        } else if (lower.includes('pdf') || lower.includes('rapport')) {
            reply = '📄 Après l\'analyse, prenez une photo et cliquez sur <em>Télécharger le PDF</em>.';
        } else if (lower.includes('bonjour') || lower.includes('salut') || lower.includes('hello')) {
            reply = '👋 Bonjour ! Comment puis-je vous aider aujourd\'hui ?';
        } else if (lower.includes('recommandation') || lower.includes('conseil')) {
            reply = analysisResult
                ? '💡 Consultez les recommandations affichées ci-dessous dans la section résultats.'
                : "Lancez d'abord l'analyse pour obtenir des recommandations personnalisées.";
        } else {
            const fallbacks = [
                "Je suis spécialisé dans la gestion du stress étudiant. Posez-moi des questions sur votre sommeil, vos études ou votre bien-être !",
                "Essayez de me demander : <em>Quel est mon niveau de stress ?</em> ou <em>Comment améliorer mon sommeil ?</em>",
                "Je peux vous aider avec : stress, sommeil, études, recommandations, PDF. Que souhaitez-vous savoir ?"
            ];
            reply = fallbacks[Math.floor(Math.random() * fallbacks.length)];
        }
        addMsg(reply, 'bot');
    }, 1000 + Math.random() * 500);
}

// ── ML Analysis ──
async function runAnalysis() {
    const nom = document.getElementById('nomInput').value.trim();
    const score = parseInt(document.getElementById('scoreInput').value);
    if (!nom) { addMsg('⚠️ Veuillez entrer votre prénom avant de lancer l\'analyse.', 'bot'); return; }
    if (isNaN(score) || score < 0 || score > 100) { addMsg('⚠️ Veuillez entrer un score valide entre 0 et 100.', 'bot'); return; }

    addMsg(`🚀 Lancement de l'analyse pour <strong>${nom}</strong> avec un score de <strong>${score}/100</strong>...`, 'user');
    showTyping();

    try {
        const resp = await fetch(PREDICT_URL, {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({
                nom, score,
                sleep_hours: SURVEY_DATA.sleepHours,
                study_hours: SURVEY_DATA.studyHours,
                coffee_cups: 2, age: 20, sport_hours: 1
            })
        });
        const data = await resp.json();
        hideTyping();

        if (data.success) {
            analysisResult = data;
            const emoji = data.stress_pct > 70 ? '🔴' : data.stress_pct > 40 ? '🟡' : '🟢';
            addMsg(`✅ Analyse terminée pour <strong>${nom}</strong> !<br><br>
                ${emoji} Stress : <strong>${data.stress_pct}%</strong> (${data.stress_level})<br>
                😊 Bonheur : <strong>${data.happiness_level}</strong><br>
                📊 Score bien-être : <strong>${score}/100</strong><br><br>
                Consultez les recommandations et l'emploi du temps ci-dessous.`, 'bot');

            // Show results
            showResults(data);
            document.getElementById('btnPdf').disabled = false;
        } else {
            addMsg('❌ Erreur lors de l\'analyse. Veuillez réessayer.', 'bot');
        }
    } catch (e) {
        hideTyping();
        addMsg('❌ Erreur de connexion. Vérifiez votre réseau.', 'bot');
    }
}

function showResults(data) {
    const section = document.getElementById('resultsSection');
    section.style.display = 'block';
    section.scrollIntoView({behavior:'smooth', block:'start'});

    // Recommendations
    const recsList = document.getElementById('recsList');
    recsList.innerHTML = '';
    (data.recommendations || []).forEach(r => {
        const div = document.createElement('div');
        div.className = 'rec-item';
        div.innerHTML = `<span>${r}</span>`;
        recsList.appendChild(div);
    });

    // Schedule
    const tbody = document.getElementById('scheduleBody');
    tbody.innerHTML = '';
    (data.emploi_du_temps || []).forEach(row => {
        const tr = document.createElement('tr');
        tr.innerHTML = `<td><strong>${row.heure}</strong></td><td>${row.activite}</td>`;
        tbody.appendChild(tr);
    });
}

// ── Camera ──
async function startCamera() {
    try {
        cameraStream = await navigator.mediaDevices.getUserMedia({video: true});
        const video = document.getElementById('videoEl');
        video.srcObject = cameraStream;
        video.style.display = 'block';
        document.getElementById('btnStart').style.display = 'none';
        document.getElementById('btnSnap').style.display = 'flex';
        addMsg('📷 Caméra activée ! Cliquez sur <em>Prendre</em> pour capturer votre photo.', 'bot');
    } catch (e) {
        addMsg('❌ Impossible d\'accéder à la caméra. Vérifiez les permissions.', 'bot');
    }
}

function takePhoto() {
    const video = document.getElementById('videoEl');
    const canvas = document.getElementById('canvasEl');
    const ctx = canvas.getContext('2d');
    ctx.drawImage(video, 0, 0, canvas.width, canvas.height);
    photoDataUrl = canvas.toDataURL('image/jpeg', 0.8);
    const preview = document.getElementById('photoPreview');
    preview.src = photoDataUrl;
    preview.style.display = 'block';
    video.style.display = 'none';
    document.getElementById('btnSnap').style.display = 'none';
    document.getElementById('btnRetake').style.display = 'flex';
    if (cameraStream) { cameraStream.getTracks().forEach(t => t.stop()); }
    addMsg('✅ Photo prise avec succès ! Elle sera incluse dans votre rapport PDF.', 'bot');
}

function retakePhoto() {
    photoDataUrl = null;
    document.getElementById('photoPreview').style.display = 'none';
    document.getElementById('btnRetake').style.display = 'none';
    document.getElementById('btnStart').style.display = 'flex';
}

// ── PDF Generation ──
async function downloadPDF() {
    if (!analysisResult) { addMsg('⚠️ Lancez d\'abord l\'analyse.', 'bot'); return; }
    const { jsPDF } = window.jspdf;
    const doc = new jsPDF({ orientation: 'portrait', unit: 'mm', format: 'a4' });
    const nom = document.getElementById('nomInput').value || 'Étudiant';
    const score = document.getElementById('scoreInput').value || '0';
    const pageW = doc.internal.pageSize.getWidth();
    let y = 0;

    // Header gradient simulation
    doc.setFillColor(102, 126, 234);
    doc.rect(0, 0, pageW, 45, 'F');
    doc.setFillColor(118, 75, 162);
    doc.rect(pageW/2, 0, pageW/2, 45, 'F');

    doc.setTextColor(255, 255, 255);
    doc.setFontSize(22); doc.setFont('helvetica', 'bold');
    doc.text('Rapport Anti-Stress', pageW/2, 18, {align:'center'});
    doc.setFontSize(11); doc.setFont('helvetica', 'normal');
    doc.text('StudyFlow - Analyse personnalisée', pageW/2, 27, {align:'center'});
    doc.text(new Date().toLocaleDateString('fr-FR', {weekday:'long',year:'numeric',month:'long',day:'numeric'}), pageW/2, 35, {align:'center'});
    y = 55;

    // Photo
    if (photoDataUrl) {
        try {
            doc.addImage(photoDataUrl, 'JPEG', pageW/2 - 25, y, 50, 38, '', 'FAST');
            doc.setDrawColor(102, 126, 234); doc.setLineWidth(0.8);
            doc.roundedRect(pageW/2 - 25, y, 50, 38, 3, 3, 'S');
            y += 45;
        } catch(e) {}
    }

    // Student info
    doc.setFillColor(240, 244, 255);
    doc.roundedRect(15, y, pageW - 30, 28, 3, 3, 'F');
    doc.setTextColor(31, 41, 55); doc.setFontSize(13); doc.setFont('helvetica', 'bold');
    doc.text('Etudiant : ' + nom, 22, y + 9);
    doc.setFontSize(10); doc.setFont('helvetica', 'normal');
    doc.text('Score bien-etre : ' + score + '/100', 22, y + 17);
    doc.text('Sommeil : ' + SURVEY_DATA.sleepHours + 'h  |  Etude : ' + SURVEY_DATA.studyHours + 'h  |  Date : ' + SURVEY_DATA.date, 22, y + 24);
    y += 35;

    // Stress level
    const stressPct = analysisResult.stress_pct || 0;
    doc.setFillColor(stressPct > 70 ? 239 : stressPct > 40 ? 251 : 74, stressPct > 70 ? 68 : stressPct > 40 ? 146 : 222, stressPct > 70 ? 68 : stressPct > 40 ? 60 : 128);
    doc.roundedRect(15, y, pageW - 30, 16, 3, 3, 'F');
    doc.setTextColor(255,255,255); doc.setFontSize(11); doc.setFont('helvetica', 'bold');
    doc.text('Niveau de stress : ' + stressPct + '% (' + (analysisResult.stress_level || 'N/A') + ')  |  Bonheur : ' + (analysisResult.happiness_level || 'N/A'), pageW/2, y + 10, {align:'center'});
    y += 24;

    // Recommendations
    doc.setTextColor(31, 41, 55); doc.setFontSize(13); doc.setFont('helvetica', 'bold');
    doc.text('Recommandations personnalisees', 15, y); y += 8;
    doc.setFontSize(9); doc.setFont('helvetica', 'normal');
    (analysisResult.recommendations || []).forEach((r, i) => {
        const clean = r.replace(/[^\x00-\x7E\u00C0-\u024F]/g, '');
        const lines = doc.splitTextToSize((i+1) + '. ' + clean, pageW - 35);
        if (y + lines.length * 5 > 270) { doc.addPage(); y = 20; }
        doc.setTextColor(55, 65, 81);
        doc.text(lines, 20, y); y += lines.length * 5 + 3;
    });
    y += 5;

    // Schedule
    if (y + 20 > 270) { doc.addPage(); y = 20; }
    doc.setTextColor(31, 41, 55); doc.setFontSize(13); doc.setFont('helvetica', 'bold');
    doc.text('Emploi du temps personnalise', 15, y); y += 8;
    doc.setFillColor(102, 126, 234);
    doc.rect(15, y, 35, 7, 'F');
    doc.rect(50, y, pageW - 65, 7, 'F');
    doc.setTextColor(255,255,255); doc.setFontSize(9); doc.setFont('helvetica', 'bold');
    doc.text('Heure', 17, y + 5);
    doc.text('Activite', 52, y + 5);
    y += 9;
    (analysisResult.emploi_du_temps || []).forEach((row, i) => {
        if (y + 8 > 280) { doc.addPage(); y = 20; }
        if (i % 2 === 0) { doc.setFillColor(248, 250, 252); doc.rect(15, y, pageW - 30, 7, 'F'); }
        doc.setTextColor(55, 65, 81); doc.setFontSize(8); doc.setFont('helvetica', 'normal');
        doc.text(row.heure, 17, y + 5);
        const act = row.activite.replace(/[^\x00-\x7E\u00C0-\u024F]/g, '');
        doc.text(act, 52, y + 5);
        y += 7;
    });

    // Footer
    const totalPages = doc.internal.getNumberOfPages();
    for (let p = 1; p <= totalPages; p++) {
        doc.setPage(p);
        doc.setFillColor(102, 126, 234);
        doc.rect(0, 287, pageW, 10, 'F');
        doc.setTextColor(255,255,255); doc.setFontSize(8);
        doc.text('StudyFlow - Rapport confidentiel - Page ' + p + '/' + totalPages, pageW/2, 293, {align:'center'});
    }

    doc.save('rapport_stress_' + nom.replace(/\s+/g,'_') + '_' + new Date().toISOString().split('T')[0] + '.pdf');
    addMsg('📄 Votre rapport PDF a été téléchargé avec succès !', 'bot');
}
</script>
{% endblock %}
