{% extends 'base.html.twig' %}

{% block title %}Évaluation Stress Étudiant{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
        }

        .header-area { background: rgba(0,0,0,0.25) !important; backdrop-filter: blur(10px); }
        .header-area .logo h1, .header-area .nav a,
        nav, .navbar, nav *, .navbar *, .nav-link { color: white !important; }

        /* ── Hero ── */
        .hero-section { padding: 130px 20px 35px; text-align: center; }

        .hero-badge {
            display: inline-flex; align-items: center; gap: 8px;
            background: rgba(255,255,255,0.2); color: white;
            padding: 8px 20px; border-radius: 30px; font-size: 0.9rem; font-weight: 600;
            margin-bottom: 18px; backdrop-filter: blur(10px);
            border: 1px solid rgba(255,255,255,0.3);
        }
        .hero-title {
            font-size: 2.6rem; font-weight: 800; color: white;
            text-shadow: 2px 2px 8px rgba(0,0,0,0.2); margin-bottom: 10px;
        }
        .hero-subtitle {
            font-size: 1.05rem; color: rgba(255,255,255,0.85);
            max-width: 560px; margin: 0 auto 30px; line-height: 1.7;
        }

        /* ── Steps ── */
        .steps-bar { display: flex; justify-content: center; align-items: center; margin-bottom: 40px; }
        .step-item  { display: flex; align-items: center; gap: 8px; }
        .step-circle {
            width: 38px; height: 38px; border-radius: 50%;
            background: rgba(255,255,255,0.2); border: 2px solid rgba(255,255,255,0.4);
            color: white; font-weight: 700; font-size: 0.9rem;
            display: flex; align-items: center; justify-content: center;
        }
        .step-circle.active {
            background: white; color: #667eea; border-color: white;
            box-shadow: 0 4px 15px rgba(255,255,255,0.4);
        }
        .step-label { color: rgba(255,255,255,0.72); font-size: 0.8rem; font-weight: 600; }
        .step-label.active { color: white; }
        .step-connector { width: 50px; height: 2px; background: rgba(255,255,255,0.3); margin: 0 4px; }

        /* ── Card ── */
        .form-container { max-width: 760px; margin: 0 auto; padding: 0 20px 80px; }

        .form-card {
            background: white; border-radius: 24px; overflow: hidden;
            box-shadow: 0 20px 60px rgba(0,0,0,0.25);
            animation: fadeUp 0.5s ease-out;
        }
        @keyframes fadeUp {
            from { opacity: 0; transform: translateY(20px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        .form-card-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            padding: 26px 36px; display: flex; align-items: center; gap: 16px;
        }
        .header-icon {
            width: 54px; height: 54px; background: rgba(255,255,255,0.2);
            border-radius: 14px; display: flex; align-items: center;
            justify-content: center; font-size: 1.6rem; color: white;
        }
        .header-text h2 { color: white; font-size: 1.35rem; font-weight: 700; margin-bottom: 3px; }
        .header-text p  { color: rgba(255,255,255,0.75); font-size: 0.85rem; }

        .form-body { padding: 36px; }

        /* ── Flash messages ── */
        .flash-success {
            background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 12px;
            padding: 14px 18px; margin-bottom: 22px; color: #16a34a;
            display: flex; align-items: center; gap: 10px; font-size: 0.9rem; font-weight: 600;
        }
        .flash-error {
            background: #fef2f2; border: 1px solid #fecaca; border-radius: 12px;
            padding: 14px 18px; margin-bottom: 22px; color: #dc2626;
            display: flex; align-items: center; gap: 10px; font-size: 0.9rem;
        }

        /* ── Constraints box ── */
        .constraints-box {
            background: #f0f4ff; border: 1px solid #c7d2fe;
            border-radius: 12px; padding: 15px 18px; margin-bottom: 26px;
        }
        .constraints-box h4 {
            font-size: 0.83rem; font-weight: 700; color: #4338ca;
            margin-bottom: 9px; display: flex; align-items: center; gap: 6px;
        }
        .constraints-box ul { list-style: none; padding: 0; margin: 0; }
        .constraints-box li {
            font-size: 0.8rem; color: #4b5563; padding: 2px 0;
            display: flex; align-items: flex-start; gap: 7px;
        }
        .constraints-box li::before { content: "✓"; color: #667eea; font-weight: 700; flex-shrink: 0; }

        /* ── Field groups ── */
        .field-group { margin-bottom: 24px; }

        .field-label {
            display: flex; align-items: center; gap: 8px;
            font-weight: 700; color: #374151; font-size: 0.92rem; margin-bottom: 8px;
        }
        .label-icon {
            width: 28px; height: 28px; border-radius: 7px;
            display: flex; align-items: center; justify-content: center;
            font-size: 0.8rem; color: white; flex-shrink: 0;
        }
        .icon-date  { background: linear-gradient(135deg, #667eea, #764ba2); }
        .icon-sleep { background: linear-gradient(135deg, #4facfe, #00f2fe); }
        .icon-study { background: linear-gradient(135deg, #f093fb, #f5576c); }
        .icon-user  { background: linear-gradient(135deg, #43e97b, #38f9d7); }

        /* inputs */
        .field-input-wrap input,
        .field-input-wrap select {
            width: 100%; padding: 13px 16px;
            border: 2px solid #e5e7eb; border-radius: 12px;
            font-size: 0.96rem; color: #1f2937; background: #f9fafb;
            transition: all 0.25s; outline: none; appearance: auto;
        }
        .field-input-wrap input:focus,
        .field-input-wrap select:focus {
            border-color: #667eea; background: white;
            box-shadow: 0 0 0 4px rgba(102,126,234,0.12);
        }
        .field-input-wrap input.is-invalid,
        .field-input-wrap select.is-invalid {
            border-color: #ef4444; background: #fff5f5;
        }
        .field-hint {
            margin-top: 5px; font-size: 0.79rem; color: #9ca3af;
            display: flex; align-items: center; gap: 5px;
        }
        .form-error-list { list-style: none; margin: 6px 0 0; padding: 0; }
        .form-error-list li {
            font-size: 0.82rem; color: #ef4444;
            display: flex; align-items: center; gap: 5px;
        }
        .form-error-list li::before { content: "⚠ "; }

        /* ── Slider bar ── */
        .slider-row { display: flex; align-items: center; gap: 13px; }
        .slider-row input[type="number"] { width: 85px; text-align: center; flex-shrink: 0; }
        .slider-visual { flex: 1; height: 8px; background: #e5e7eb; border-radius: 4px; overflow: hidden; }
        .slider-fill   { height: 100%; border-radius: 4px; transition: width 0.3s; }
        .fill-sleep { background: linear-gradient(90deg, #4facfe, #00f2fe); }
        .fill-study { background: linear-gradient(90deg, #f093fb, #f5576c); }
        .slider-val { font-weight: 700; min-width: 28px; font-size: 0.88rem; }

        /* ── Divider ── */
        .section-divider { display: flex; align-items: center; gap: 13px; margin: 24px 0; }
        .section-divider hr { flex: 1; border: none; border-top: 2px solid #f3f4f6; }
        .section-divider span {
            font-size: 0.73rem; font-weight: 700; color: #9ca3af;
            text-transform: uppercase; letter-spacing: 1px; white-space: nowrap;
        }

        /* ── Submit ── */
        .submit-area {
            display: flex; justify-content: space-between;
            align-items: center; gap: 13px; margin-top: 10px;
        }
        .btn-back {
            display: inline-flex; align-items: center; gap: 8px;
            padding: 13px 24px; background: #f3f4f6; color: #6b7280;
            border: none; border-radius: 12px; font-size: 0.95rem; font-weight: 600;
            text-decoration: none; transition: all 0.25s; cursor: pointer;
        }
        .btn-back:hover { background: #e5e7eb; color: #374151; text-decoration: none; }

        .btn-submit {
            display: inline-flex; align-items: center; gap: 10px;
            padding: 14px 36px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white; border: none; border-radius: 12px;
            font-size: 1rem; font-weight: 700; cursor: pointer;
            transition: all 0.25s; box-shadow: 0 6px 20px rgba(102,126,234,0.4);
        }
        .btn-submit:hover { transform: translateY(-2px); box-shadow: 0 10px 28px rgba(102,126,234,0.5); }

        /* ── Info cards ── */
        .info-cards {
            display: grid; grid-template-columns: repeat(3, 1fr);
            gap: 13px; margin-top: 26px;
        }
        .info-card {
            background: rgba(255,255,255,0.13); border: 1px solid rgba(255,255,255,0.22);
            border-radius: 16px; padding: 18px; text-align: center;
            backdrop-filter: blur(10px); transition: all 0.3s;
        }
        .info-card:hover { background: rgba(255,255,255,0.22); transform: translateY(-4px); }
        .info-card i  { font-size: 1.7rem; color: white; margin-bottom: 8px; display: block; }
        .info-card h4 { color: white; font-size: 0.88rem; font-weight: 700; margin-bottom: 4px; }
        .info-card p  { color: rgba(255,255,255,0.7); font-size: 0.76rem; line-height: 1.4; }

        @media (max-width: 600px) {
            .hero-title { font-size: 1.8rem; }
            .form-body  { padding: 20px 16px; }
            .info-cards { grid-template-columns: 1fr; }
            .submit-area { flex-direction: column; }
            .btn-submit, .btn-back { width: 100%; justify-content: center; }
            .step-connector { width: 22px; }
        }
    </style>
{% endblock %}

{% block body %}
{% block header %}{% include 'home/navbar.html.twig' %}{% endblock %}

<div class="hero-section">
    <div class="hero-badge">
        <i class="fas fa-brain"></i> Module Anti-Stress
    </div>
    <h1 class="hero-title">Évaluez votre niveau de stress</h1>
    <p class="hero-subtitle">
        Remplissez ce questionnaire journalier pour obtenir une analyse IA personnalisée
        de votre bien-être et des recommandations adaptées.
    </p>

    <div class="steps-bar">
        <div class="step-item">
            <div class="step-circle active">1</div>
            <span class="step-label active">Questionnaire</span>
        </div>
        <div class="step-connector"></div>
        <div class="step-item">
            <div class="step-circle">2</div>
            <span class="step-label">Analyse IA</span>
        </div>
        <div class="step-connector"></div>
        <div class="step-item">
            <div class="step-circle">3</div>
            <span class="step-label">Rapport PDF</span>
        </div>
    </div>
</div>

<div class="form-container">
    <div class="form-card">

        <div class="form-card-header">
            <div class="header-icon"><i class="fas fa-clipboard-list"></i></div>
            <div class="header-text">
                <h2>Questionnaire Journalier</h2>
                <p>Tous les champs sont obligatoires — enregistrement en base de données</p>
            </div>
        </div>

        <div class="form-body">

            {# Flash messages #}
            {% for msg in app.flashes('success') %}
                <div class="flash-success">
                    <i class="fas fa-check-circle"></i> {{ msg }}
                </div>
            {% endfor %}
            {% for msg in app.flashes('error') %}
                <div class="flash-error">
                    <i class="fas fa-exclamation-circle"></i> {{ msg }}
                </div>
            {% endfor %}

            {# Constraints summary #}
            <div class="constraints-box">
                <h4><i class="fas fa-shield-alt"></i> Règles de validation</h4>
                <ul>
                    <li>Date obligatoire, valide et ne peut pas être dans le futur</li>
                    <li>Heures de sommeil : nombre entier entre 0 et 24</li>
                    <li>Heures d'étude : nombre entier entre 0 et 24</li>
                    <li>Utilisateur : obligatoire, doit exister en base de données (clé étrangère)</li>
                </ul>
            </div>

            {{ form_start(form, {
                'attr': { 'id': 'stresseForm', 'novalidate': 'novalidate' }
            }) }}

            {# ── Date ── #}
            <div class="field-group">
                <label class="field-label" for="{{ form.date.vars.id }}">
                    <span class="label-icon icon-date"><i class="fas fa-calendar-day"></i></span>
                    Date du sondage <span style="color:#ef4444;margin-left:2px">*</span>
                </label>
                <div class="field-input-wrap">
                    {{ form_widget(form.date, {
                        'attr': {
                            'class': form.date.vars.errors|length > 0 ? 'is-invalid' : '',
                            'id': 'dateField'
                        }
                    }) }}
                </div>
                <div class="field-hint">
                    <i class="fas fa-info-circle"></i> Date obligatoire — ne peut pas être dans le futur
                </div>
                {% if form.date.vars.errors|length > 0 %}
                    <ul class="form-error-list">
                        {% for error in form.date.vars.errors %}<li>{{ error.message }}</li>{% endfor %}
                    </ul>
                {% endif %}
            </div>

            <div class="section-divider">
                <hr><span>Habitudes de sommeil &amp; d'étude</span><hr>
            </div>

            {# ── Heures de sommeil ── #}
            <div class="field-group">
                <label class="field-label" for="{{ form.sleepHours.vars.id }}">
                    <span class="label-icon icon-sleep"><i class="fas fa-moon"></i></span>
                    Heures de sommeil cette nuit <span style="color:#ef4444;margin-left:2px">*</span>
                </label>
                <div class="slider-row">
                    {{ form_widget(form.sleepHours, {
                        'attr': {
                            'class': form.sleepHours.vars.errors|length > 0 ? 'is-invalid' : '',
                            'id': 'sleepInput',
                            'oninput': 'updateBar("sleepInput","sleepBar","sleepVal",24)'
                        }
                    }) }}
                    <div class="slider-visual">
                        <div class="slider-fill fill-sleep" id="sleepBar" style="width:0%"></div>
                    </div>
                    <span class="slider-val" id="sleepVal" style="color:#4facfe">0h</span>
                </div>
                <div class="field-hint">
                    <i class="fas fa-info-circle"></i> Entier entre 0 et 24 · Recommandé : 7–9 h
                </div>
                {% if form.sleepHours.vars.errors|length > 0 %}
                    <ul class="form-error-list">
                        {% for error in form.sleepHours.vars.errors %}<li>{{ error.message }}</li>{% endfor %}
                    </ul>
                {% endif %}
            </div>

            {# ── Heures d'étude ── #}
            <div class="field-group">
                <label class="field-label" for="{{ form.studyHours.vars.id }}">
                    <span class="label-icon icon-study"><i class="fas fa-graduation-cap"></i></span>
                    Heures d'étude aujourd'hui <span style="color:#ef4444;margin-left:2px">*</span>
                </label>
                <div class="slider-row">
                    {{ form_widget(form.studyHours, {
                        'attr': {
                            'class': form.studyHours.vars.errors|length > 0 ? 'is-invalid' : '',
                            'id': 'studyInput',
                            'oninput': 'updateBar("studyInput","studyBar","studyVal",24)'
                        }
                    }) }}
                    <div class="slider-visual">
                        <div class="slider-fill fill-study" id="studyBar" style="width:0%"></div>
                    </div>
                    <span class="slider-val" id="studyVal" style="color:#f5576c">0h</span>
                </div>
                <div class="field-hint">
                    <i class="fas fa-info-circle"></i> Entier entre 0 et 24
                </div>
                {% if form.studyHours.vars.errors|length > 0 %}
                    <ul class="form-error-list">
                        {% for error in form.studyHours.vars.errors %}<li>{{ error.message }}</li>{% endfor %}
                    </ul>
                {% endif %}
            </div>

            <div class="section-divider">
                <hr><span>Identification de l'étudiant</span><hr>
            </div>

            {# ── Utilisateur (user_id FK) ── #}
            <div class="field-group">
                <label class="field-label" for="{{ form.user.vars.id }}">
                    <span class="label-icon icon-user"><i class="fas fa-user"></i></span>
                    Votre identifiant étudiant <span style="color:#ef4444;margin-left:2px">*</span>
                </label>
                <div class="field-input-wrap">
                    {{ form_widget(form.user, {
                        'attr': {
                            'class': form.user.vars.errors|length > 0 ? 'is-invalid' : '',
                            'id': 'userSelect'
                        }
                    }) }}
                </div>
                <div class="field-hint">
                    <i class="fas fa-info-circle"></i>
                    Obligatoire — doit correspondre à un utilisateur existant (clé étrangère)
                </div>
                {% if form.user.vars.errors|length > 0 %}
                    <ul class="form-error-list">
                        {% for error in form.user.vars.errors %}<li>{{ error.message }}</li>{% endfor %}
                    </ul>
                {% endif %}
            </div>

            {# ── Actions ── #}
            <div class="submit-area">
                <a href="{{ path('app_studyflow') }}" class="btn-back">
                    <i class="fas fa-arrow-left"></i> Retour
                </a>
                {{ form_widget(form.enregistrer, {
                    'attr': { 'class': 'btn-submit', 'id': 'submitBtn' }
                }) }}
            </div>

            {{ form_end(form) }}
        </div>
    </div>

    {# Info cards #}
    <div class="info-cards">
        <div class="info-card">
            <i class="fas fa-database"></i>
            <h4>Sauvegarde sécurisée</h4>
            <p>Données enregistrées en base avec validation FK utilisateur</p>
        </div>
        <div class="info-card">
            <i class="fas fa-brain"></i>
            <h4>IA Prédictive</h4>
            <p>Analyse basée sur des modèles de machine learning avancés</p>
        </div>
        <div class="info-card">
            <i class="fas fa-file-pdf"></i>
            <h4>Rapport PDF</h4>
            <p>Téléchargez votre bilan avec emploi du temps personnalisé</p>
        </div>
    </div>
</div>
{% endblock %}

{% block body_scripts %}
<script>
document.addEventListener('DOMContentLoaded', function () {
    // Set today as default date and max
    const dateField = document.getElementById('dateField');
    if (dateField) {
        const today = new Date().toISOString().split('T')[0];
        dateField.setAttribute('max', today);
        if (!dateField.value) dateField.value = today;
    }
    // Init bars from existing values (after form re-render on error)
    updateBar('sleepInput', 'sleepBar', 'sleepVal', 24);
    updateBar('studyInput', 'studyBar', 'studyVal', 24);
});

function updateBar(inputId, barId, valId, max) {
    const input = document.getElementById(inputId);
    const bar   = document.getElementById(barId);
    const label = document.getElementById(valId);
    if (!input || !bar || !label) return;
    const val = Math.min(Math.max(parseInt(input.value) || 0, 0), max);
    bar.style.width = (val / max * 100) + '%';
    label.textContent = val + 'h';
}

// Front-end validation
document.getElementById('stresseForm').addEventListener('submit', function (e) {
    let valid = true;

    // Date
    const dateField = document.getElementById('dateField');
    const today = new Date().toISOString().split('T')[0];
    if (!dateField.value || dateField.value > today) {
        dateField.classList.add('is-invalid'); valid = false;
    } else { dateField.classList.remove('is-invalid'); }

    // Sleep hours
    const sleepEl = document.getElementById('sleepInput');
    const sleep = parseInt(sleepEl.value);
    if (isNaN(sleep) || sleep < 0 || sleep > 24) {
        sleepEl.classList.add('is-invalid'); valid = false;
    } else { sleepEl.classList.remove('is-invalid'); }

    // Study hours
    const studyEl = document.getElementById('studyInput');
    const study = parseInt(studyEl.value);
    if (isNaN(study) || study < 0 || study > 24) {
        studyEl.classList.add('is-invalid'); valid = false;
    } else { studyEl.classList.remove('is-invalid'); }

    // User
    const userEl = document.getElementById('userSelect');
    if (!userEl || !userEl.value) {
        if (userEl) userEl.classList.add('is-invalid'); valid = false;
    } else { if (userEl) userEl.classList.remove('is-invalid'); }

    if (!valid) {
        e.preventDefault();
        e.stopPropagation();
        const firstInvalid = document.querySelector('.is-invalid');
        if (firstInvalid) firstInvalid.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
});
</script>
{% endblock %}
